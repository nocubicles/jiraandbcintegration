# Business Central target
BC_TENANT_ID=7e6efb3b-5060-4666-aee5-ffe6f3cb3644
BC_ENVIRONMENT=sandbox
BC_COMPANY_ID=<company system id, from GET /api/v2.0/companies>

# Entra app registration used for service-to-service access to BC.
# Register it in BC on page 9860 "Microsoft Entra Applications" with permission set
# "BCJ JiraIntegration" (and D365 BUS FULL ACCESS), state Enabled.
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=

# Shown as the page title
BRAND_NAME=Integrated Technologies time review
PORT=3000
